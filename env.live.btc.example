# ReadyTrader-Crypto — BTC live production profile (EXAMPLE ONLY)
#
# Copy to `.env.live` (gitignored) and fill secrets out-of-band.
# Use with: docker-compose -f docker-compose.live.yml --env-file .env.live up -d
#
# DO NOT put real secrets in this file. DO NOT commit `.env.live`.
# CEX keys MUST be trade+read only — NEVER enable withdraw.

# --- Core mode (live stack; remain halted until operator unhalts) ---
PAPER_MODE=false
LIVE_TRADING_ENABLED=true
TRADING_HALTED=true
DEV_MODE=false
EXECUTION_MODE=cex
EXECUTION_APPROVAL_MODE=approve_each
RISK_PROFILE=conservative

# --- API auth (required when DEV_MODE=false) ---
API_AUTH_REQUIRED=true
API_HOST=0.0.0.0
API_PORT=8000
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_JWT_SECRET=REPLACE_WITH_JWT_SECRET
API_JWT_EXPIRATION_HOURS=24
API_ADMIN_USERNAME=admin
# Generate: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('YOUR_PASSWORD'))"
API_ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
CORS_ORIGINS=http://localhost:3000

# --- BTC CEX policy ---
ALLOW_EXCHANGES=binance,kraken,coinbase
ALLOW_CEX_SYMBOLS=btc/usdt,btc/usd
ALLOW_CEX_MARKET_TYPES=spot
MAX_CEX_ORDER_AMOUNT=0.01
MAX_TRADE_AMOUNT=500

# DEX allowlists unused for EXECUTION_MODE=cex but required by some compose checks:
ALLOW_CHAINS=ethereum
ALLOW_TOKENS=wbtc,usdt,usdc,eth

# --- Signer (never env_private_key for live) ---
SIGNER_TYPE=remote
SIGNER_REMOTE_URL=https://signer.internal:8080
REMOTE_SIGNER_REQUIRE_TLS=true
REMOTE_SIGNER_TIMEOUT_SEC=30
REMOTE_SIGNER_RETRY_COUNT=3
SIGNER_POLICY_ENABLED=true
SIGNER_ALLOWED_CHAIN_IDS=1
SIGNER_MAX_VALUE_WEI=0
SIGNER_MAX_GAS=500000
SIGNER_DISALLOW_CONTRACT_CREATION=true
# ALLOW_SIGNER_ADDRESSES=0xYOUR_TRADING_WALLET

# --- CEX credentials (trade+read, NO withdraw; IP allowlist at exchange) ---
# CEX_BINANCE_API_KEY=
# CEX_BINANCE_API_SECRET=
# CEX_KRAKEN_API_KEY=
# CEX_KRAKEN_API_SECRET=
# CEX_COINBASE_API_KEY=
# CEX_COINBASE_API_SECRET=

MARKETDATA_EXCHANGES=binance,kraken,coinbase
CCXT_DEFAULT_TYPE=spot

# --- Observability ---
READYTRADER_LOG_LEVEL=info
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Persistence (container paths match docker-compose.live.yml) ---
AUDIT_DB_PATH=/app/data/audit.db
IDEMPOTENCY_DB_PATH=/app/data/idempotency.db
EXECUTION_DB_PATH=/app/data/execution.db
