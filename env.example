# ReadyTrader-Crypto example configuration (DO NOT PUT REAL SECRETS IN THIS FILE)
#
# Copy to `.env` and fill in values as needed.
# `.env` is ignored by git (see `.gitignore`).

# --- Core mode ---
PAPER_MODE=true

# Execution routing: dex | cex | hybrid | auto
EXECUTION_MODE=hybrid

# Live trading is blocked by default even if PAPER_MODE=false.
# You must opt-in and accept the one-time disclosure (per container run).
LIVE_TRADING_ENABLED=false
TRADING_HALTED=true

# Development mode (relaxes some security requirements)
# Set to true for local development, false for production
# DEV_MODE=false

# Execution approval: auto | approve_each
# - auto: execute immediately
# - approve_each: live actions return proposals; confirm via the HTTP API (POST /api/approve-trade with request_id + confirm_token). Paper mode never proposes.
EXECUTION_APPROVAL_MODE=auto

# API & WebSocket (Next.js Backend)
API_PORT=8000
API_HOST=0.0.0.0

# --- API Authentication (REQUIRED when DEV_MODE=false for api_server) ---
# api_server refuses to start if DEV_MODE=false and API_AUTH_REQUIRED=false
# API_AUTH_REQUIRED=true

# JWT secret (REQUIRED when API_AUTH_REQUIRED=true in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# API_JWT_SECRET=your-secret-here

# JWT expiration time in hours
# API_JWT_EXPIRATION_HOURS=24

# Admin credentials
# API_ADMIN_USERNAME=admin
# Generate password hash with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
# API_ADMIN_PASSWORD_HASH=$2b$12$...

# Legacy plaintext password (DEV_MODE only - DO NOT USE IN PRODUCTION)
# API_ADMIN_PASSWORD=admin

# --- CORS Configuration ---
# Allowed origins (comma-separated). Wildcard '*' is forbidden when DEV_MODE=false for api_server / live.
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Notification Webhooks (Discord/Telegram)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# Strategy / Backtest preferences
# Risk profile preset (applies runtime policy overrides)
RISK_PROFILE=conservative

# --- Optional policy allowlists/limits (deny-by-policy ONLY if set) ---
# ALLOW_CHAINS=ethereum,base,arbitrum,optimism
# ALLOW_TOKENS=usdc,weth,usdt,eth
# ALLOW_ROUTERS=0xrouter1,0xrouter2
# MAX_TRADE_AMOUNT=1000
# MAX_TRANSFER_NATIVE=0.1
# ALLOW_TO_ADDRESSES=0xabc...,0xdef...
# DEX_SLIPPAGE_PCT=1.0
#
# CEX policy:
# ALLOW_EXCHANGES=binance,kraken,coinbase
# ALLOW_CEX_SYMBOLS=btc/usdt,eth/usdt
# ALLOW_CEX_MARKET_TYPES=spot,swap,future
# MAX_CEX_ORDER_AMOUNT=0.05
#
# Optional signer allowlist:
# ALLOW_SIGNER_ADDRESSES=0xabc...,0xdef...

# --- Signer configuration (required only for PAPER_MODE=false + on-chain execution) ---
# SIGNER_TYPE=env_private_key | keystore | remote
SIGNER_TYPE=env_private_key
# PRIVATE_KEY=0x...
# KEYSTORE_PATH=/path/to/keystore.json
# KEYSTORE_PASSWORD=...
# SIGNER_REMOTE_URL=http://signer:8080
#
# Coinbase cb-mpc (2-party) signer (recommended for high security):
# - Run `mpc_signer` party 0 + party 1 services.
# - Point the Sentinel signer at the leader:
# SIGNER_TYPE=cb_mpc_2pc
# MPC_SIGNER_URL=http://mpc-party-0:8787

# Remote signer settings (SIGNER_TYPE=remote)
# REMOTE_SIGNER_TIMEOUT_SEC=30
# REMOTE_SIGNER_RETRY_COUNT=3
# REMOTE_SIGNER_REQUIRE_TLS=true

# --- CEX credentials (required only for authenticated CEX tools) ---
# Generic:
# CEX_API_KEY=...
# CEX_API_SECRET=...
# CEX_API_PASSWORD=...
#
# Per-exchange (preferred):
# CEX_BINANCE_API_KEY=...
# CEX_BINANCE_API_SECRET=...
# CEX_BINANCE_API_PASSWORD=...

# --- Market data (CCXT REST + caching) ---
MARKETDATA_EXCHANGES=binance,kraken,coinbase
CCXT_DEFAULT_TYPE=spot
# CCXT_PROXY=http://127.0.0.1:7890
TICKER_CACHE_TTL_SEC=5
OHLCV_CACHE_TTL_SEC=60
MARKETS_CACHE_TTL_SEC=300
HTTP_TIMEOUT_SEC=10

# --- Rate limiting (Phase 6, in-memory; resets on restart) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_EXECUTION_PER_MIN=20

# --- Optional persistence (Phase 1B, OFF by default) ---
# Audit log of tool activity (SQLite). Does NOT store risk-consent state.
# AUDIT_DB_PATH=/data/audit.db
#
# Idempotency cache persistence (SQLite). Helps avoid duplicate executions across agent retries.
# IDEMPOTENCY_DB_PATH=/data/idempotency.db
#
# Execution proposal persistence (SQLite) for operator visibility.
# Proposals are invalidated across restarts via a per-process session id.
# EXECUTION_DB_PATH=/data/execution.db

# --- Private updates (Phase 2C) ---
# Non-binance exchanges use a polling fallback for private order updates.
# CEX_PRIVATE_POLL_INTERVAL_SEC=2.0

# --- Market data routing (Phase 3) ---
# Provider priorities (lower = higher priority)
# MARKETDATA_PROVIDER_PRIORITY_JSON={"exchange_ws":0,"ingest":1,"ccxt_rest":2}
#
# Freshness thresholds
# MARKETDATA_MAX_AGE_MS=30000
# MARKETDATA_MAX_AGE_MS_EXCHANGE_WS=15000
#
# Outlier detection (compares vs last good tick)
# MARKETDATA_OUTLIER_MAX_PCT=20.0
# MARKETDATA_OUTLIER_WINDOW_MS=10000
#
# Optional fail-closed if best available data is stale/outlier
# MARKETDATA_FAIL_CLOSED=false
#
# External providers (Phase 3C)
# MARKETDATA_PLUGINS_JSON=[{"class":"marketdata.plugin_examples:StaticJsonFileProvider","provider_id":"file_feed","kwargs":{"path":"/data/feed.json"}}]

# --- Operator logging + metrics (Phase 4) ---
# Logging level: debug | info | warn | error
# READYTRADER_LOG_LEVEL=info
# READYTRADER_SERVICE_NAME=readytrader
#
# Metrics namespace for Prometheus text output
# READYTRADER_METRICS_NS=readytrader

# --- Enterprise signing policies (Phase 5) ---
# Signer-side (local) defense-in-depth policy wrapper (off by default)
# SIGNER_POLICY_ENABLED=false
# SIGNER_ALLOWED_CHAIN_IDS=1,8453,42161,10
# SIGNER_ALLOWED_TO_ADDRESSES=0xrouter1,0xrouter2
# SIGNER_MAX_VALUE_WEI=0
# SIGNER_MAX_GAS=500000
# SIGNER_MAX_GAS_PRICE_WEI=200000000000
# SIGNER_MAX_DATA_BYTES=2000
# SIGNER_DISALLOW_CONTRACT_CREATION=true
#
# PolicyEngine signer-intent guardrails (off by default)
# ALLOW_SIGN_CHAIN_IDS=1,8453,42161,10
# ALLOW_SIGN_TO_ADDRESSES=0xrouter1,0xrouter2
# MAX_SIGN_VALUE_WEI=0
# MAX_SIGN_GAS=500000
# MAX_SIGN_GAS_PRICE_WEI=200000000000
# MAX_SIGN_DATA_BYTES=2000
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# --- Multi-Agent & Strategy Persistence (Phase 3) ---
# INSIGHT_DB_PATH=data/insights.db
# STRATEGY_DB_PATH=data/strategies.db
# PAPER_DB_PATH=data/paper.db

# --- Intelligence & Sentiment APIs ---

#
# Free (No Key Required): 
# - RSS Market News (CoinDesk, Cointelegraph)
# - Crypto Fear & Greed Index (Alternative.me)
#
# Free (Key Required):
# - CryptoPanic: Get API token at https://cryptopanic.com/developers/api/
# CRYPTOPANIC_API_KEY=...
#
# - NewsAPI (Generic Finance): Get key at https://newsapi.org/
# NEWSAPI_KEY=...
#
# - Reddit: Create an 'installed' or 'script' app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
#
# - X (Twitter): Create a project at https://developer.x.com/en/portal/dashboard
# TWITTER_BEARER_TOKEN=...

